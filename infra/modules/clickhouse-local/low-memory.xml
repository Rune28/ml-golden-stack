<!--
  Server settings for a small pod. ClickHouse defaults assume a dedicated
  machine: caches of several GiB and a couple of dozen system log tables
  that keep writing in the background.
-->
<clickhouse>
    <!-- Hard cap for the whole server, below the container limit. -->
    <max_server_memory_usage>536870912</max_server_memory_usage>

    <mark_cache_size>67108864</mark_cache_size>
    <uncompressed_cache_size>67108864</uncompressed_cache_size>
    <index_mark_cache_size>0</index_mark_cache_size>
    <index_uncompressed_cache_size>0</index_uncompressed_cache_size>
    <mmap_cache_size>64</mmap_cache_size>

    <!-- Background pools keep their defaults: shrinking them conflicts with
         the merge_tree pool settings and saves little, idle threads cost
         almost no memory. -->
    <concurrent_threads_soft_limit_num>2</concurrent_threads_soft_limit_num>

    <!-- System log tables of the default config (26.8): not needed locally,
         each one is a MergeTree table flushed every few seconds. -->
    <aggregated_zookeeper_log remove="1"/>
    <asynchronous_insert_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <background_schedule_pool_log remove="1"/>
    <backup_log remove="1"/>
    <blob_storage_log remove="1"/>
    <delta_lake_metadata_log remove="1"/>
    <error_log remove="1"/>
    <iceberg_metadata_log remove="1"/>
    <instrumentation_trace_log remove="1"/>
    <metric_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
    <part_log remove="1"/>
    <processors_profile_log remove="1"/>
    <query_log remove="1"/>
    <query_metric_log remove="1"/>
    <query_thread_log remove="1"/>
    <query_views_log remove="1"/>
    <text_log remove="1"/>
    <trace_log remove="1"/>
    <zookeeper_connection_log remove="1"/>
    <zookeeper_log remove="1"/>

    <logger>
        <level>warning</level>
        <console>1</console>
    </logger>
</clickhouse>
